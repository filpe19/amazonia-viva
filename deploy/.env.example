# Domínio público (o registro DNS A deve apontar para o IP do servidor antes de subir o Caddy)
DOMAIN=amazoniaviva.example.org
# Opcional: chave FIRMS (API por área, mais estável que os arquivos públicos) — https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Opcional, recomendado para uso público da imagem de alta resolução (ArcGIS Location Platform, plano gratuito)
VITE_ARCGIS_API_KEY=
