# Amazônia Viva — configuração do back-end (copie para .env)
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json            # json | console

# NASA FIRMS — chave gratuita em https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Sem chave, a plataforma usa os arquivos públicos NRT da NASA FIRMS (sem credencial).
# A chave é usada só no back-end e nunca é enviada ao navegador.
FIRMS_MAP_KEY=
FIRMS_NRT_CACHE_TTL_SECONDS=900

# NASA POWER (sem chave)
POWER_CACHE_TTL_SECONDS=21600

# HTTP externo
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# Origens permitidas (front-end)
CORS_ORIGINS=["http://localhost:5710","http://127.0.0.1:5710"]
